{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ShellyRGBAudio",
  "version": "0.1.0",
  "identifier": "eu.sytxlabs.shellyrgbaudio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "ShellyRGBAudio – Einstellungen",
        "width": 1100,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "SytxLabs",
    "copyright": "© 2026 SytxLabs",
    "category": "Utility",
    "shortDescription": "Turns what you hear into light.",
    "longDescription": "Captures the audio this machine plays, analyses its spectrum and drives Shelly, WLED and Govee lights from it.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "template": "./windows/installer.nsi",
        "installMode": "currentUser",
        "languages": ["German", "English"],
        "displayLanguageSelector": true
      }
    }
  }
}
